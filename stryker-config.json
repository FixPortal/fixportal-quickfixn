{
  "stryker-config": {
    "project": "QuickFix.csproj",
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "report-file-name": "mutation-report",
    "mutation-level": "Standard",
    "coverage-analysis": "off",
    "test-runner": "vstest",
    "concurrency": 4,
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "mutate": [
      "**/*.cs"
    ]
  }
}
